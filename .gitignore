.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Generated at build time by data/cert/run_gen_script.py
*x509_crt_bundle.bin

# Release output (scripts/collect_release.py)
release/

# Never commit signing keys or other secrets
*signing-key*.pem
*secret*

# Local leftovers of the v1 Electron installer (removed in v2; replaced by the web installer)
/installer/

# v1 configuration (compiled-in Wi-Fi password and agent secret). v2 keeps settings in NVS.
src/config/
